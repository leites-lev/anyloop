{
	"_comment": "Park both FSM DAC channels at 0 V and exit. The DAC retains the programmed value after process shutdown, so camera-only ROI and COM captures that follow see the same plant state as the calibration pipelines.",
	"pipeline": [
		{
			"uri": "anyloop:test_source",
			"params": {
				"type": "vector",
				"kind": "constant",
				"size1": 1,
				"offset": 0.0
			}
		},
		{
			"uri": "anyloop:parport_dac",
			"params": {
				"delay_ns": 1000,
				"backend": "mmio",
				"pci": "0000:06:00.2",
				"link": "spi",
				"channel": [0, 1],
				"index": [0, 0],
				"range": "+-5",
				"scale": [0, 0],
				"offset": [0, 0],
				"verify": false
			}
		},
		{
			"uri": "anyloop:stop_after_count",
			"params": {"count": 2}
		}
	]
}
